# Geheimnisse - auch Sicherungskopien wie .env.bak
.env
.env.*
!.env.example

# Deine Inhalte: Layout, Symbole, gesprochene Sätze. Bewusst nicht
# versioniert - hier stehen Namen, Fotos und Sätze deines Kindes drin.
# Beim ersten Start wird der Ordner aus example/ befüllt.
content/

# arduino-cli legt sein Zwischenverzeichnis im Sketchordner an
firmware/mitreden/build/

# Was die Firmware bekommt, entsteht in Sekunden neu aus content/
firmware/mitreden/data/
# layout.h wird nicht mehr erzeugt, kann aber aus alten Ständen herumliegen -
# und enthielt die Sätze im Klartext.
firmware/mitreden/layout.h
firmware/mitreden/littlefs.bin


# Python
.venv/
__pycache__/
*.pyc
