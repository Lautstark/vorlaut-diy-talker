# Secrets - including backup copies like .env.bak
.env
.env.*
!.env.example

# Your content: layout, symbols, spoken sentences. Deliberately not
# versioned - the names, photos and sentences of your child are in here.
# On the first start the folder is filled from example/.
#
# No trailing slash on purpose. "content/" matches a directory only, and a
# content that is a symlink onto a network share - which is one of the ways
# this is meant to be moved - is not a directory to git. It would have been
# offered up for committing like any other new file.
content

# The same content again, seen from the container: docker-compose.yml hands
# data/ in as /data, so this is where it lands when the container is run from
# a clone. No trailing slash for the same reason as above.
data

# arduino-cli puts its intermediate directory inside the sketch folder
firmware/vorlaut/build/
# the same for the test stages
firmware/tests/*/build/
# where --output-dir collects the finished images, as CI and the release do.
# An 8 MB merged.bin is easy to commit by accident and hard to get back out.
build/

# What the firmware gets is recreated from content/ in seconds
firmware/vorlaut/data/
# layout.h is no longer produced, but may be lying around from older states -
# and it held the sentences in plain text.
firmware/vorlaut/layout.h
firmware/vorlaut/littlefs.bin


# Python
# Also without a trailing slash, and for a reason that turned up in practice:
# a worktree that symlinks .venv to the one next door - so that .venv/bin/python
# keeps working there - had that symlink staged by git add -A.
.venv
__pycache__/
*.pyc

# What tools/leveling.py renders for the browser to level and hand back.
# Twenty WAVs three times over, none of them worth keeping.
/dump/
