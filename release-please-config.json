{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "component": "builder",
      "initial-version": "0.1.0",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "firmware",
        "case",
        "device"
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Rearranged"
        },
        {
          "type": "docs",
          "section": "Written down"
        },
        {
          "type": "build",
          "section": "Build and dependencies"
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Chores",
          "hidden": true
        }
      ],
      "draft": false,
      "prerelease": false
    }
  }
}
