{
  "extends": "@lautstark/toolchain/tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],

    /* The port from JavaScript was a rename, not a rewrite: the modules came
       across unchanged so that the frozen references still measure the same
       code. Implicit any is what that costs, and it is the one strictness flag
       turned off rather than the whole of `strict` - strictNullChecks, which is
       where the real bugs are, stays on. Turn this on file by file as the
       signatures get written.

       It did not stay on, until 2026-10-01: this comment said so above a
       `false`, in this file and in tsconfig.e2e.json, and turning it on found
       twenty-nine errors. Nearly all of them were empty array literals, which
       are arrays of nothing under this flag, and the one that could happen at
       run time was getContext() answering null - see scratch() in
       loader/src/tiles.ts. */
    "noImplicitAny": false,
    "strictNullChecks": true,


    /* loader/tools/cable.js is JavaScript on purpose and is included below, so the
       compiler has to be willing to read it. checkJs stays off: that file is
       held to the C reader by tests/test_cable_format.py, which is a stronger
       statement about it than tsc would make, and turning it on would ask for
       annotations in a file two other runtimes import raw. */
    "allowJs": true,

    "verbatimModuleSyntax": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  /* One program's worth of source, and one file that is not part of it.
     `loader` is the page that takes an exported file to a talker: it was a
     directory of its own beside `src` because it travelled with firmware/ and
     device/ when this repository was split, and after adr/0012 that is what
     happened - src/ is vorlaut-editor's and this is what stayed. The directory
     keeps its name even though the page is now the root; see loader/README.md.

     loader/tools/cable.js is named a second time because it is JavaScript, and
     it lives under tools/ rather than src/ because the bench page and the node
     harness import it from there as it is written: a copy beside the modules
     would be a second implementation of a protocol whose whole point is that
     one implementation is checked against the firmware's. See the head of
     loader/src/cable.ts. */
  "include": ["loader", "loader/tools/cable.js"]
}
