{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],

    "strict": true,
    /* The port from JavaScript was a rename, not a rewrite: the modules came
       across unchanged so that the frozen references still measure the same
       code. Implicit any is what that costs, and it is the one strictness flag
       turned off rather than the whole of `strict` - strictNullChecks, which is
       where the real bugs are, stays on. Turn this on file by file as the
       signatures get written. */
    "noImplicitAny": false,
    "strictNullChecks": false,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* tools/cable.js is JavaScript on purpose and is included below, so the
       compiler has to be willing to read it. checkJs stays off: that file is
       held to the C reader by tests/test_cable_format.py, which is a stronger
       statement about it than tsc would make, and turning it on would ask for
       annotations in a file two other runtimes import raw. */
    "allowJs": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  /* The one file outside src/ the page imports. It stays in tools/ because the
     bench and the node harness import it from there as it is written, and
     because a copy under src/ would be a second implementation of a protocol
     whose whole point is that one implementation is checked against the
     firmware's. See the head of src/backend/cable.ts. */
  "include": ["src", "tools/cable.js"]
}
