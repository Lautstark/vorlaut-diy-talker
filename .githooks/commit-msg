#!/bin/sh
# Conventional Commits, checked as the message is written.
#
# This is a CONVENIENCE, not the gate. The gate is
# .github/workflows/commit-messages.yml, which checks every commit in a push
# to main and cannot be skipped or forgotten.
#
# This hook exists because CI tells you after the push, when the commit is
# already history and fixing it means rewriting a branch somebody may have
# pulled. The hook tells you while the message is still in the editor.
#
# Turn it on once - git does not carry hooks, and a fresh clone has it off:
#
#     git config core.hooksPath .githooks
#
# In a worktree this is inherited: worktrees share the main repository's
# config, so setting it once covers all of them. A fresh CLONE is the case
# that starts without it, which is exactly why the gate is in CI.
#
# The rule itself lives in tools/check-commit-subject.sh, so that this and CI
# cannot drift apart. See docs/releases.md.

root=$(git rev-parse --show-toplevel)
subject=$(head -1 "$1")

if "$root/tools/check-commit-subject.sh" "$subject"; then
  exit 0
fi

echo "To commit anyway, once:  git commit --no-verify" >&2
echo >&2
exit 1
