# Nothing in here is needed for the offline voices. A piper voice speaks
# without a key, without a region and without a network:
#   pip install piper-tts && python3 tools/voices.py
# Which voice speaks is chosen on the page and stands in layout.json, not here.

# Azure Speech: key and region have to match each other.
# A free account is enough; the F0 tier includes 0.5 million characters a month.
AZURE_SPEECH_KEY=put-your-own-key-here

# Region of the key. Shown in the Azure portal at the Speech resource.
AZURE_SPEECH_REGION=germanywestcentral

# Optional. Which languages the Azure voices are offered in. Azure has 556 of
# them; without this line it stays at German and English.
#AZURE_SPEECH_LANGUAGES=de-DE,en-US

# From the time before the voice stood in layout.json. An entry here decides
# which voice an existing installation carries over on the first start - after
# that the page answers the question. Available voices:  python tts.py --voices
#AZURE_SPEECH_VOICE=de-DE-GiselaNeural

# Optional. Speaking rate, e.g. -5% or +10%.
#AZURE_SPEECH_RATE=-5%

# Optional. Path to a licensed METACOM collection (the unpacked download).
# The symbols are only referenced, never copied into the project.
#VORLAUT_METACOM_DIR=/Users/you/METACOM_9_Desktop

# Optional. Key for the sync with the talker. Without this entry the device
# endpoints stay shut - the recordings and pictures are behind them.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
#VORLAUT_DEVICE_TOKEN=put-a-long-random-value-here
