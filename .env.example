# Azure Speech: Schlüssel und Region müssen zusammenpassen.
# Ein kostenloses Konto genügt; die Stufe F0 enthält 0,5 Mio. Zeichen im Monat.
AZURE_SPEECH_KEY=hier-den-eigenen-schluessel-eintragen

# Region des Schlüssels. Steht im Azure-Portal bei der Speech-Ressource.
AZURE_SPEECH_REGION=germanywestcentral

# Optional. Verfügbare Stimmen zeigt:  python tts.py --stimmen
# Die Sprache wird aus dem Namen abgeleitet (de-DE-GiselaNeural -> de-DE).
#AZURE_SPEECH_VOICE=de-DE-GiselaNeural

# Optional. Sprechtempo, z. B. -5% oder +10%.
#AZURE_SPEECH_RATE=-5%
