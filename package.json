{
  "name": "vorlaut-diy-talker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Editor for a small AAC talker: five keys that are displays at the same time.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "preflight": "node tools/installcheck.mjs",
    "test": "node tools/installcheck.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tools/installcheck.mjs && BASE_PATH=/vorlaut-diy-talker/ npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "build:pages": "BASE_PATH=/vorlaut-diy-talker/ npm run build"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@lautstark/bildquelle": "github:Lautstark/bildquelle#v1.4.1",
    "@lautstark/design": "github:Lautstark/design#claude/dialog-layer",
    "@lautstark/sicherung": "github:Lautstark/sicherung#v1.1.0",
    "@lautstark/stimmquelle": "github:Lautstark/stimmquelle#v2.7.0",
    "onnxruntime-web": "1.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
