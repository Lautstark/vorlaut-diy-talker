{
  "name": "vorlaut-diy-talker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The DIY talker: five keys that are displays at the same time - the firmware, the enclosure, and the page that takes an exported board to the device down a USB-C cable.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "preflight": "node tools/installcheck.mjs",
    "test": "node tools/installcheck.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tools/installcheck.mjs && BASE_PATH=/ npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "build:pages": "BASE_PATH=/ npm run build"
  },
  "dependencies": {
    "@lautstark/design": "github:Lautstark/design#v1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
