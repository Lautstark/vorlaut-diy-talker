{
  "name": "vorlaut",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Editor for a small AAC talker: five keys that are displays at the same time.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "BASE_PATH=/vorlaut/ npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "build:pages": "BASE_PATH=/vorlaut/ npm run build"
  },
  "dependencies": {
    "@lautstark/bildquelle": "github:Lautstark/bildquelle#semver:^1.0.0",
    "@lautstark/stimmquelle": "github:Lautstark/stimmquelle#v2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
